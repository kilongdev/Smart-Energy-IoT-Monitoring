# Chạy npm run setup để sinh .env với mật khẩu ngẫu nhiên.
PORT=3000
NODE_ENV=development
MONGO_DB=smart_energy
MONGO_ROOT_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
MONGO_URI=mongodb://root:REPLACE_WITH_RANDOM_PASSWORD@localhost:27018/smart_energy?authSource=admin
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
DEMO_PASSWORD=REPLACE_WITH_ANOTHER_STRONG_PASSWORD
SEED_DEMO=true
MQTT_URL=mqtt://localhost:1883
MQTT_USERNAME=energy_api
MQTT_PASSWORD=REPLACE_WITH_RANDOM_MQTT_PASSWORD
SIM_MQTT_PASSWORD=REPLACE_WITH_RANDOM_SIM_PASSWORD
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SIM_MODE=normal
SIM_ACK_MODE=normal
