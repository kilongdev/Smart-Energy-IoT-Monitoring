# Atlas + EMQX Cloud. Run npm run setup, then enter cloud credentials.
PORT=3000
NODE_ENV=development
MONGO_DB=smart_energy
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@YOUR_CLUSTER.mongodb.net/smart_energy?retryWrites=true&w=majority
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
DEMO_PASSWORD=REPLACE_WITH_ANOTHER_STRONG_PASSWORD
SEED_DEMO=false
MQTT_URL=mqtts://YOUR_EMQX_HOST:8883
MQTT_USERNAME=REPLACE_WITH_EMQX_USERNAME
MQTT_PASSWORD=REPLACE_WITH_EMQX_PASSWORD
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Public web URL for Telegram links. Leave empty until the web is public.
DASHBOARD_URL=
SIM_MODE=normal
SIM_ACK_MODE=normal
