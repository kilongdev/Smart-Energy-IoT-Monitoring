diff --git a/src/realtime-trace.ts b/src/realtime-trace.ts
new file mode 100644
--- /dev/null
+++ b/src/realtime-trace.ts
@@ -0,0 +1,6 @@
+// Opt-in timing diagnostics. Callers pass IDs/times/states only, never payloads
+// containing credentials. No database writes and no change to event contracts.
+export function realtimeTrace(stage: string, fields: Record<string, unknown>) {
+  if (process.env.REALTIME_TRACE !== 'true') return;
+  console.info(JSON.stringify({ trace: 'energy-realtime', stage, at: new Date().toISOString(), ...fields }));
+}
diff --git a/web/alert-refresh.ts b/web/alert-refresh.ts
new file mode 100644
--- /dev/null
+++ b/web/alert-refresh.ts
@@ -0,0 +1,26 @@
+// Serialize alert reads without dropping an invalidation received in flight.
+// If another event arrives, discard the outdated result and immediately reread.
+export function createAlertRefresh<T>(read: () => Promise<T>, commit: (value: T) => void,
+  onError: (error: unknown) => void) {
+  let pending: Promise<void> | undefined;
+  let dirty = false;
+  let disposed = false;
+  return {
+    request(invalidate = true): Promise<void> {
+      if (disposed) return Promise.resolve();
+      if (!pending || invalidate) dirty = true;
+      if (pending) return pending;
+      pending = (async () => {
+        do {
+          dirty = false;
+          try {
+            const value = await read();
+            if (!disposed && !dirty) commit(value);
+          } catch (error) { if (!disposed && !dirty) onError(error); }
+        } while (dirty && !disposed);
+      })().finally(() => { pending = undefined; });
+      return pending;
+    },
+    dispose() { disposed = true; },
+  };
+}
